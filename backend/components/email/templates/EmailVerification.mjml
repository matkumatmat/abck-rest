<!-- subject: Verify your email address -->
<mjml>
  <mj-head>
    <mj-title>Verify your email</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" align="center" color="#1a1a1a">
          Verify your email address
        </mj-text>
        <mj-text padding-top="20px">
          Hi {{ user_name }},
        </mj-text>
        <mj-text>
          Thank you for signing up. Please click the button below to verify your email address:
        </mj-text>
        <mj-button href="{{ verification_link }}" background-color="#2563eb" color="#ffffff" padding="30px 0" font-size="16px" border-radius="6px">
          Verify Email
        </mj-button>
        <mj-text>
          Or copy and paste this link into your browser:
        </mj-text>
        <mj-text font-size="12px" color="#2563eb" word-break="break-all">
          {{ verification_link }}
        </mj-text>
        <mj-text padding-top="20px">
          This link will expire in {{ expires_in }}.
        </mj-text>
        <mj-text color="#666666" font-size="12px" padding-top="30px">
          If you did not create an account, please ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
