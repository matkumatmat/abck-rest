<!-- subject: Reset your password -->
<mjml>
  <mj-head>
    <mj-title>Reset your password</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" align="center" color="#1a1a1a">
          Reset your password
        </mj-text>
        <mj-text padding-top="20px">
          Hi {{ user_name }},
        </mj-text>
        <mj-text>
          We received a request to reset your password. Click the button below to create a new password:
        </mj-text>
        <mj-button background-color="#2563eb" color="#ffffff" href="{{ reset_link }}" padding="30px 0">
          Reset Password
        </mj-button>
        <mj-text>
          This link will expire in {{ expires_in }}.
        </mj-text>
        <mj-text color="#666666" font-size="12px" padding-top="30px">
          If you did not request a password reset, please ignore this email or contact support if you have concerns.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
